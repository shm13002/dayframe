{
  "name": "dayframe-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dayframe's web surfaces: the Briefing tab (React) and the notch-island show (canvas).",
  "scripts": {
    "dev": "vite",
    "dev:island": "vite --config vite.island.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:briefing": "vite build",
    "build:island": "vite build --config vite.island.config.ts",
    "build": "npm run typecheck && npm run build:briefing && npm run build:island"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3"
  }
}
